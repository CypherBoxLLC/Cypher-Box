{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Metro Bundler",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/react-native/local-cli/cli.js", "start"],
      "port": 8081
    },
    {
      "name": "Android",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "android"],
      "port": 5554
    },
    {
      "name": "iOS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ios"],
      "port": 8081
    },
    {
      "name": "Windows",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "windows"],
      "port": 8081
    }
  ]
}

# yarn.lock is a stale BlueWallet-fork artifact. Cypher Box uses npm ci
# (see CLAUDE.md). Keeping this ignored blocks an accidental
# `yarn install` from re-committing it and re-importing the 56 alerts
# that came with it.
yarn.lock


0647\u200c\u0627\u0646\u062f.",details_adv_import:"\u0648\u0627\u0631\u062f\u06a9\u0631\u062f\u0646 \u062a\u0631\u0627\u06a9\u0646\u0634",details_adv_import_qr:"\u0648\u0627\u0631\u062f\u06a9\u0631\u062f\u0646 \u062a\u0631\u0627\u06a9\u0646\u0634 (QR)",details_amount_field_is_not_valid:"\u0645\u0642\u062f\u0627\u0631 \u0645\u0639\u062a\u0628\u0631 \u0646\u06cc\u0633\u062a.",details_amount_field_is_less_than_minimum_amount_sat:"\u0645\u0642\u062f\u0627\u0631 \u062a\u0639\u06cc\u06cc\u0646\u200c\u0634\u062f\u0647 \u0628\u0633\u06cc\u0627\u0631 \u06a9\u0645 \u0627\u0633\u062a. \u0644\u0637\u0641\u0627\u064b \u0645\u0642\u062f\u0627\u0631\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0627\u0632 \u06f5\u06f0\u06f0 \u0633\u0627\u062a\u0648\u0634\u06cc \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f.",details_create:"\u0627\u06cc\u062c\u0627\u062f \u0635\u0648\u0631\u062a\u200c\u062d\u0633\u0627\u0628",details_error_decode:"\u0646\u0627\u0645\u0648\u0641\u0642 \u062f\u0631 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0622\u062f\u0631\u0633 \u0628\u06cc\u062a\u200c\u06a9\u0648\u06cc\u0646",details_fee_field_is_not_valid:"\u06a9\u0627\u0631\u0645\u0632\u062f \u0645\u0639\u062a\u0628\u0631 \u0646\u06cc\u0633\u062a.",details_frozen:"{amount} \u0628\u06cc\u062a\u200c\u06a9\u0648\u06cc\u0646 \u0645\u0633\u062f\u0648\u062f \u0634\u062f\u0647 \u0627\u0633\u062a.",details_next:"\u0628\u0639\u062f\u06cc",details_no_signed_tx:"\u0641\u0627\u06cc\u0644 \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0634\u062f\u0647 \u062d\u0627\u0648\u06cc \u062a\u0631\u0627\u06a9\u0646\u0634\u06cc \u0646\u06cc\u0633\u062a \u06a9\u0647 \u0628\u062a\u0648\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0631\u062f.",details_note_placeholder:"\u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0628\u0647 \u062e\u0648\u062f",details_scan:"\u0627\u0633\u06a9\u0646",details_scan_hint:"\u062c\u0647\u062a \u0627\u0633\u06a9\u0646 \u06cc\u0627 \u0648\u0627\u0631\u062f\u06a9\u0631\u06
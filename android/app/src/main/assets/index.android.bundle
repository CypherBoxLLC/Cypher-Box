d7\u05e1\u05d5\u05df '\u05de\u05d6\u05d5\u05d9\u05e3' \u05d7\u05d3\u05e9 \u05d9\u05e4\u05ea\u05d7. \u05de\u05e6\u05d1 \u05d6\u05d4 \u05d9\u05e8\u05d0\u05d4 \u05dc\u05d2\u05d9\u05d8\u05d9\u05de\u05d9 \u05dc\u05e6\u05d3 \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9, \u05d1\u05d6\u05de\u05df \u05e9\u05d4\u05d0\u05d7\u05e1\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d9 \u05d9\u05e9\u05de\u05e8 \u05d1\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd \u05db\u05e9\u05d4\u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05de\u05d5\u05d2\u05e0\u05d9\u05dd.",help2:"\u05d4\u05d0\u05d7\u05e1\u05d5\u05df \u05d4\u05d7\u05d3\u05e9 \u05d9\u05ea\u05e4\u05e7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05dc\u05d0, \u05d5\u05ea\u05d5\u05db\u05dc\u05d5 \u05dc\u05d0\u05d7\u05e1\u05df \u05d1\u05d5 \u05e1\u05db\u05d5\u05de\u05d9\u05dd \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05d9\u05dd \u05db\u05da \u05e9\u05d9\u05e8\u05d0\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05d9\u05de\u05df.",password_should_not_match:"\u05d4\u05e1\u05d9\u05e1\u05de\u05d4 \u05db\u05d1\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9. \u05d0\u05e0\u05d0 \u05e0\u05e1\u05d5 \u05e1\u05d9\u05e1\u05de\u05d4 \u05d0\u05d7\u05e8\u05ea.",passwords_do_not_match:"\u05e1\u05d9\u05e1\u05de\u05d0\u05d5\u05ea \u05d0\u05d9\u05e0\u05df \u05ea\u05d5\u05d0\u05de\u05d5\u05ea, \u05d0\u05e0\u05d0 \u05e0\u05e1\u05d5 \u05e9\u05d5\u05d1",retype_password:"\u05d4\u05db\u05e0\u05d9\u05e1\u05d5 \u05e9\u05d5\u05d1 \u05e1\u05d9\u05e1\u05de\u05d4",success:"\u05d4\u05e6\u05dc\u05d7\u05d4",title:"\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05db\u05d7\u05e9\u05d4 \u05e1\u05d1\u05d9\u05e8\u05d4"},pleasebackup:{ask:"\u05d4\u05d0\u05dd \u05e9\u05de\u05e8\u05ea \u05d0\u05ea \u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05e9\u05dc\u05da? \u05de\u05d9\u05dc\u05d5\u05ea \u05d2\u05d9\u05d1\u05d5\u05d9 \u05d0\u05dc\u05d4 \u05d3\u05e8\u05d5\u05e9\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d2\u05e9\u05ea \u05dc\u05db\u05e1\u05e4\u05d9\u05dd \u05e9\u05dc\u05da \u05d1\u0
\u0dd9\u0db1\u0dd4\u0dc0 \u0db4\u0dbb\u0dd2\u0dbd\u0ddd\u0d9a\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1",reset_amount:"\u0db8\u0dd4\u0daf\u0dbd \u0db1\u0dd0\u0dc0\u0dad \u0dc3\u0d9a\u0dc3\u0db1\u0dca\u0db1",reset_amount_confirm:"\u0db8\u0dd4\u0daf\u0dbd \u0db1\u0dd0\u0dc0\u0dad \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0da7 \u0d94\u0db6 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0daf?",success_done:"\u0d9a\u0dc5\u0dcf",txSaved:"\u0d9c\u0dab\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0d9c\u0ddc\u0db1\u0dd4\u0dc0 ({filePath}) \u0d94\u0db6\u0dda \u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0dc6\u0ddd\u0dbd\u0dca\u0da9\u0dbb\u0dba\u0dda \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd3 \u0d87\u0dad.",problem_with_psbt:"PSBT \u0dc3\u0db8\u0d9f \u0d9c\u0dd0\u0da7\u0dc5\u0dd4\u0dc0"},settings:{about:"\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0",about_awesome:"\u0db1\u0dd2\u0dba\u0db8 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0dd9\u0db1\u0dca \u0d89\u0daf\u0dd2 \u0d9a\u0dbb \u0d87\u0dad",about_backup:"\u0d94\u0db6\u0dda \u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dd0\u0db8\u0dc0\u0dd2\u0da7\u0db8 \u0d8b\u0db4\u0dc3\u0dca\u0dae \u0d9a\u0dbb\u0db1\u0dca\u0db1!",about_free:"\u0db6\u0dca\u0dbd\u0dd6\u0dc0\u0ddc\u0dbd\u0da7\u0dca \u0dba\u0db1\u0dd4 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dc4\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0db8\u0dd6\u0dbd\u0dcf\u0dc1\u0dca\u200d\u0dbb \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0dd2. \u0db6\u0dd2\u0da7\u0dca\u0d9a\u0ddc\u0dba\u0dd2\u0db1\u0dca \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd2.",about_license:"\u0d91\u0db8\u0dca.\u0d85\u0dba\u0dd2.\u0da7\u0dd3 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba",about_release_notes:"\u0db8\u0dd4\u0daf\u0dcf \u0dc4\u0dd0\u0dbb\u0dd3\u0db8\u0dda \u0dc3\u0da7\u0dc4\u0db1\u0dca",about_review:"\u0d85\u0db4\u0da7 \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1\u0dba\u0d9a\u0dca \u0dad\u0db6\u0db1\u0dca\
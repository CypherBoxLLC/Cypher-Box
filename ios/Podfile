def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

workspace 'BlueWallet'
platform :ios, min_ios_version_supported
prepare_react_native_project!
setup_permissions(['Camera', 'Notifications'])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

plugin 'cocoapods-bugsnag'

# Define a common function to configure shared settings for targets
def configure_target()
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => true,
    :new_arch_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  pod 'react-native-bw-file-access', :path => '../blue_modules/react-native-bw-file-access'
end

target 'BlueWallet' do
  configure_target()
end

target 'BlueWallet-NoLDK' do
  configure_target()
end

post_install do |installer|
  react_native_post_install(
    installer,
    "../node_modules/react-native",
    :mac_catalyst_enabled => true
  )

  # Force the Pods project default to c++20.
  #
  # Why: CocoaPods generates the Pods.xcodeproj with a project-level default
  # of `gnu++14` (__cplusplus == 201402L). Most pods override this in their
  # own podspec, but a few don't — most notably React-jsi, whose xcconfig
  # has no CLANG_CXX_LANGUAGE_STANDARD at all and inherits the project
  # default. When NitroModules / RN 0.76's newer RCT-Folly is in the dep
  # graph, Folly's Portability.h hits:
  #     static_assert(__cplusplus >= 201703L, ...)
  # and the build cascades into hundreds of "auto not allowed in template
  # parameter until C++17" errors. Setting the project-level default to
  # c++20 fixes React-jsi (and any other un-pinned pod) without disturbing
  # pods that explicitly pin a different standard.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
  end

  # Fix fmt consteval issue with Xcode 26 Clang
  fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
  if File.exist?(fmt_base)
    content = File.read(fmt_base)
    unless content.include?('FMT_CONSTEVAL_XCODE26_FIX')
      content.sub!(
        /^#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL 1$/,
        "// FMT_CONSTEVAL_XCODE26_FIX: force-disable consteval for Xcode 26\n#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 0"
      )
      File.write(fmt_base, content)
      Pod::UI.puts "[fmt] Patched FMT_USE_CONSTEVAL for Xcode 26 compatibility".green
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported

      # Force full dSYMs in Release for every pod target. Required so
      # the archive includes hermes.framework.dSYM (and every other
      # framework's dSYM) — App Store Connect's symbols-upload step
      # rejects the build otherwise with:
      #   "The archive did not include a dSYM for the hermes.framework
      #    with the UUIDs [...]. Ensure that the archive's dSYM folder
      #    includes a DWARF file for hermes.framework with the
      #    expected UUIDs."
      # Default Pod build setting is `dwarf` (debug info inside the
      # binary, no separate dSYM file), which is fine for Debug but
      # leaves Release archives without symbolicatable crash reports.
      # Scoped to Release only so Debug builds stay snappy.
      if config.name == 'Release'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end

      if ['React-Core-AccessibilityResources'].include? target.name
        config.build_settings['CODE_SIGN_STYLE'] = "Manual"
        config.build_settings['CODE_SIGN_IDENTITY'] = "Apple Distribution: Bluewallet Services, S. R. L. (A7W54YZ4WU)"
        config.build_settings['DEVELOPMENT_TEAM'] = "A7W54YZ4WU"
      end

      # @secondts/bark-react-native ships Fabric codegen output under
      # ios/generated/build/generated/ios/react/renderer/components/
      # RNBarkReactNativeSpec/ and the generated ShadowNodes.cpp /
      # States.cpp include their sibling headers via the angle-bracket
      # path <react/renderer/components/RNBarkReactNativeSpec/ShadowNodes.h>.
      # CocoaPods flattens public headers into Pods/Headers/Public/
      # BarkReactNative/ which loses that nested react/renderer/...
      # prefix, so the includes fail. The SDK's podspec doesn't add the
      # generated root to HEADER_SEARCH_PATHS on the modern
      # install_modules_dependencies path (RN >= 0.71). Add it here so
      # the angle-bracket include resolves against the in-place source.
      if target.name == 'BarkReactNative'
        existing = config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        added = '"${PODS_TARGET_SRCROOT}/ios/generated/build/generated/ios"'
        unless existing.to_s.include?('ios/generated/build/generated/ios')
          config.build_settings['HEADER_SEARCH_PATHS'] = [existing, added].join(' ')
        end
      end

      # react-native-share 10.2.1 declares `s.dependency "React-Codegen"`
      # in its podspec under the New Arch branch, but RN 0.77 renamed the
      # pod to `ReactCodegen` (no hyphen). The dependency silently fails
      # to resolve, so RNShare's HEADER_SEARCH_PATHS never inherit
      # Pods/Headers/Public/ReactCodegen/ where the codegen actually
      # writes <RNShareSpec/RNShareSpec.h>. Add the path explicitly so
      # the include at node_modules/react-native-share/ios/RNShare.h:12
      # resolves until react-native-share ships a podspec that names the
      # post-rename pod.
      if target.name == 'RNShare'
        existing = config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        added = '"${PODS_ROOT}/Headers/Public/ReactCodegen"'
        unless existing.to_s.include?('Headers/Public/ReactCodegen')
          config.build_settings['HEADER_SEARCH_PATHS'] = [existing, added].join(' ')
        end
      end
    end
  end
end